{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entrada do modelo preditivo da Fase 6",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "idade_media": {
      "type": "number",
      "minimum": 18,
      "maximum": 90
    },
    "carga_sistema": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "tempo_espera": {
      "type": "number",
      "minimum": 5,
      "maximum": 180
    },
    "fc_media": {
      "type": "number",
      "minimum": 50,
      "maximum": 150
    },
    "spo2_media": {
      "type": "number",
      "minimum": 70,
      "maximum": 100
    },
    "pa_sistolica": {
      "type": "number",
      "minimum": 80,
      "maximum": 200
    },
    "temperatura": {
      "type": "number",
      "minimum": 10,
      "maximum": 40
    },
    "densidade_eventos": {
      "type": "integer",
      "minimum": 0
    },
    "eventos_24h": {
      "type": "integer",
      "minimum": 0
    },
    "disponibilidade_recursos": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "idade_media",
    "carga_sistema",
    "tempo_espera",
    "fc_media",
    "spo2_media",
    "pa_sistolica",
    "temperatura",
    "densidade_eventos",
    "eventos_24h",
    "disponibilidade_recursos"
  ]
}
