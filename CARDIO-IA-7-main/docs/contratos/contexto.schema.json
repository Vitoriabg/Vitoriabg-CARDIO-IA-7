{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contexto sintetico do caso v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "const": "synthetic"
    },
    "context_revision": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "title": "Features de contexto",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idade_media": {
          "type": "number",
          "minimum": 18,
          "maximum": 90
        },
        "carga_sistema": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tempo_espera": {
          "type": "number",
          "minimum": 5,
          "maximum": 180
        },
        "spo2_media": {
          "type": "number",
          "minimum": 70,
          "maximum": 100
        },
        "pa_sistolica": {
          "type": "number",
          "minimum": 80,
          "maximum": 200
        },
        "densidade_eventos": {
          "type": "integer",
          "minimum": 0
        },
        "eventos_24h": {
          "type": "integer",
          "minimum": 0
        },
        "disponibilidade_recursos": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "idade_media",
        "carga_sistema",
        "tempo_espera",
        "spo2_media",
        "pa_sistolica",
        "densidade_eventos",
        "eventos_24h",
        "disponibilidade_recursos"
      ]
    }
  },
  "required": [
    "schema_version",
    "source",
    "context_revision",
    "values"
  ]
}
