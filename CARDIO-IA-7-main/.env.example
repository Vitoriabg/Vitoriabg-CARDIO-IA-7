# Execute Backend/scripts/init_local.py para gerar segredos locais.
CARDIOIA_API_HOST=127.0.0.1
CARDIOIA_API_PORT=8000
CARDIOIA_DATABASE_PATH=./storage/cardioia.sqlite3
CARDIOIA_OLLAMA_URL=http://127.0.0.1:11434/v1
